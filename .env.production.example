# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon/Render Postgres connection string (SSL required in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Neon CA certificate (download from Neon dashboard or AWS RDS cert bundle)
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis Cloud / Upstash connection string
REDIS_URL=redis://default:password@host:port

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_min_64_char_hex_string_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_min_64_char_hex_string_here
JWT_REFRESH_EXPIRES_IN=7d

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=generate_64_char_hex_string_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Leave blank to allow all origins (not recommended for production)
ALLOWED_ORIGINS=https://your-frontend.com,https://admin.your-frontend.com

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# ─── Sentry (optional) ───────────────────────────────────────────────────────
SENTRY_DSN=https://key@o0.ingest.sentry.io/0
